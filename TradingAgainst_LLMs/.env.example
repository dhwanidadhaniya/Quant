# Copy to .env. Never commit .env.
# Development default is the deterministic mock provider.
# A mock run does not call an external model API.

PROVIDER=mock

# OpenAI-compatible chat completions (OpenAI, Groq, Together, vLLM, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Cost controls
MAX_CONCURRENCY=4
MAX_OUTPUT_TOKENS=120
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=30

# SQLite path, relative to the repository root unless absolute
DATABASE_PATH=data/research.sqlite
